        {
            "label": "Logs: ergo-api-dev",
            "type": "shell",
            "command": "bash",
            "args": [
                "-c",
                "if [[ \"$(uname -s)\" == \"Linux\" ]]; then journalctl -u ergo-api-dev -n 500 -f | cat; else echo 'Logs not available on Windows - use Windows tasks instead'; fi"
            ],
            "options": {
                "shell": {
                    "executable": "/bin/bash",
                    "args": ["-c"]
                }
            },
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "group": "ergo-api-dev",
                "clear": false
            },
            "isBackground": false,
            "problemMatcher": []
