        {
            "label": "Install CLI (ergoms)",
            "type": "shell",
            "command": "/bin/bash",
            "args": [
                "-lc",
                "if [[ $(uname -s) == Linux ]]; then sudo /bin/bash \"${workspaceFolder}/linux/ergo_ms.sh\" install-cli | cat; else echo \"CLI installation not available on Windows - use Windows tasks instead\"; fi"
            ],
            "presentation": {
