{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Windows: Setup Full System",
            "type": "shell",
            "command": "cmd",
            "args": [
                "/c",
                "echo Starting full system setup... && cd ${workspaceFolder}/api && py -3.12 -m venv .venv && .venv\\Scripts\\activate.bat && pip install poetry && poetry install && api migrate && api collectstatic --noinput && cd ${workspaceFolder}/client && npm install && echo Setup completed successfully!"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "new",
                "showReuseMessage": true,
                "clear": false
            },
            "group": {
                "kind": "build"
            },
            "problemMatcher": []
        },
        {
            "label": "Windows: Start All Services",
            "dependsOrder": "parallel",
            "dependsOn": [
                "Windows: Client",
                "Windows: API",
                "Windows: Celery Worker", 
                "Windows: Celery Beat"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            }
        },
        {
            "label": "Windows: Client",
            "type": "shell",
            "command": "npm",
            "args": ["run", "dev"],
            "options": {
                "cwd": "${workspaceFolder}/client"
            },
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "new",
                "showReuseMessage": true,
                "clear": false
            },
            "problemMatcher": []
        },
        {
            "label": "Windows: API",
            "type": "shell",
            "command": "cmd",
            "args": ["/c", "${workspaceFolder}/api/.venv/Scripts/activate.bat && api dev"],
            "options": {
                "cwd": "${workspaceFolder}/api"
            },
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "new",
                "showReuseMessage": true,
                "clear": false
            },
            "problemMatcher": []
        },
        {
            "label": "Windows: Celery Worker",
            "type": "shell",
            "command": "cmd",
            "args": ["/c", "${workspaceFolder}/api/.venv/Scripts/activate.bat && api start_celery_worker"],
            "options": {
                "cwd": "${workspaceFolder}/api"
            },
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "new",
                "showReuseMessage": true,
                "clear": false
            },
            "problemMatcher": []
        },
        {
            "label": "Windows: Celery Beat",
            "type": "shell",
            "command": "cmd",
            "args": ["/c", "${workspaceFolder}/api/.venv/Scripts/activate.bat && api start_celery_beat"],
            "options": {
                "cwd": "${workspaceFolder}/api"
            },
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "new",
                "showReuseMessage": true,
                "clear": false
            },
            "problemMatcher": []
        },
        {
            "label": "Windows: Install Video Analysis Dependencies",
            "dependsOrder": "sequence",
            "dependsOn": [
                "Windows: Install FFmpeg",
                "Windows: Install Opus MT Model",
                "Windows: Install Vosk Model",
                "Windows: Install Silero Repo",
                "Windows: Install Silero TTS FR Model"
            ],
            "group": {
                "kind": "build"
            },
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "new",
                "showReuseMessage": true,
                "clear": false
            }
        },
        {
            "label": "Windows: Install FFmpeg",
            "type": "shell",
            "command": "cmd",
            "args": ["/c", "${workspaceFolder}/api/.venv/Scripts/activate.bat && api install_ffmpeg"],
            "options": {
                "cwd": "${workspaceFolder}/api"
            },
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "new",
                "showReuseMessage": true,
                "clear": false
            },
            "problemMatcher": []
        },
        {
            "label": "Windows: Install Opus MT Model",
            "type": "shell",
            "command": "cmd",
            "args": ["/c", "${workspaceFolder}/api/.venv/Scripts/activate.bat && api install_opus_mt"],
            "options": {
                "cwd": "${workspaceFolder}/api"
            },
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "new",
                "showReuseMessage": true,
                "clear": false
            },
            "problemMatcher": []
        },
        {
            "label": "Windows: Install Vosk Model",
            "type": "shell",
            "command": "cmd",
            "args": ["/c", "${workspaceFolder}/api/.venv/Scripts/activate.bat && api install_vosk_model"],
            "options": {
                "cwd": "${workspaceFolder}/api"
            },
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "new",
                "showReuseMessage": true,
                "clear": false
            },
            "problemMatcher": []
        },
        {
            "label": "Windows: Install Silero Repo",
            "type": "shell",
            "command": "cmd",
            "args": [
                "/c",
                "${workspaceFolder}/api/.venv/Scripts/activate.bat && api install_silero_repo"
            ],
            "options": {
                "cwd": "${workspaceFolder}/api"
            },
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "new",
                "showReuseMessage": true,
                "clear": false
            },
            "problemMatcher": []
        },
        {
            "label": "Windows: Install Silero TTS FR Model",
            "type": "shell",
            "command": "cmd",
            "args": [
                "/c",
                "${workspaceFolder}/api/.venv/Scripts/activate.bat && api install_tts_model --language fr --speaker v3_fr"
            ],
            "options": {
                "cwd": "${workspaceFolder}/api"
            },
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "new",
                "showReuseMessage": true,
                "clear": false
            },
            "problemMatcher": []
        },
        {
          "label": "Ubuntu: Logs: ergo-api-dev",
          "type": "shell",
          "command": "journalctl -u ergo-api-dev -n 500 -f | cat",
          "options": {
            "shell": {
              "executable": "/bin/bash",
              "args": ["-c"]
            }
          },
          "presentation": {
            "reveal": "always",
            "panel": "dedicated",
            "group": "ergo-api-dev",
            "clear": false
          },
          "isBackground": false,
          "problemMatcher": []
        },
        {
          "label": "Ubuntu: Logs: ergo-client-dev",
          "type": "shell",
          "command": "journalctl -u ergo-client-dev -n 500 -f | cat",
          "options": {
            "shell": {
              "executable": "/bin/bash",
              "args": ["-c"]
            }
          },
          "presentation": {
            "reveal": "always",
            "panel": "dedicated",
            "group": "ergo-client-dev",
            "clear": false
          },
          "isBackground": false,
          "problemMatcher": []
        },
        {
          "label": "Ubuntu: Logs: ergo-celery-worker",
          "type": "shell",
          "command": "journalctl -u ergo-celery-worker -n 500 -f | cat",
          "options": {
            "shell": {
              "executable": "/bin/bash",
              "args": ["-c"]
            }
          },
          "presentation": {
            "reveal": "always",
            "panel": "dedicated",
            "group": "ergo-celery-worker",
            "clear": false
          },
          "isBackground": false,
          "problemMatcher": []
        },
        {
          "label": "Ubuntu: Logs: ergo-celery-beat",
          "type": "shell",
          "command": "journalctl -u ergo-celery-beat -n 500 -f | cat",
          "options": {
            "shell": {
              "executable": "/bin/bash",
              "args": ["-c"]
            }
          },
          "presentation": {
            "reveal": "always",
            "panel": "dedicated",
            "group": "ergo-celery-beat",
            "clear": false
          },
          "isBackground": false,
          "problemMatcher": []
        },
        {
          "label": "Ubuntu: Logs: All services",
          "dependsOrder": "parallel",
          "dependsOn": [
            "Ubuntu: Logs: ergo-api-dev",
            "Ubuntu: Logs: ergo-client-dev",
            "Ubuntu: Logs: ergo-celery-worker",
            "Ubuntu: Logs: ergo-celery-beat"
          ],
          "problemMatcher": []
        },
        {
          "label": "Ubuntu: Install CLI (ergoms)",
          "type": "shell",
          "command": "sudo /bin/bash /var/www/ergo_ms/linux/ergo_ms.sh install-cli | cat",
          "options": {
            "shell": {
              "executable": "/bin/bash",
              "args": ["-c"]
            }
          },
          "presentation": {
            "reveal": "always",
            "panel": "dedicated",
            "group": "ergo-ms-cli",
            "clear": false
          },
          "isBackground": false,
          "problemMatcher": []
        }
    ]
} 