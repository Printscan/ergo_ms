{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Setup Full System",
            "type": "shell",
            "command": "bash",
            "args": [
                "-c",
                "cd '${workspaceFolder}/api' && if [[ \"$(uname -s)\" == \"Linux\" ]]; then python3 -m venv .venv && source .venv/bin/activate && pip install poetry && poetry install && api migrate && api collectstatic --noinput; else py -3.12 -m venv .venv && .venv/Scripts/activate.bat && pip install poetry && poetry install && api migrate && api collectstatic --noinput; fi && cd '${workspaceFolder}/client' && npm install"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "new",
                "showReuseMessage": true,
                "clear": false
            },
            "group": {
                "kind": "build"
            },
            "problemMatcher": []
        },
        {
            "label": "Start All Services",
            "dependsOrder": "parallel",
            "dependsOn": [
                "Client",
                "API",
                "Celery Worker",
                "Celery Beat"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            }
        },
        {
            "label": "Client",
            "type": "shell",
            "command": "npm",
            "args": ["run", "dev"],
            "options": {
                "cwd": "${workspaceFolder}/client"
            },
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "new",
                "showReuseMessage": true,
                "clear": false
            },
            "problemMatcher": []
        },
        {
            "label": "API",
            "type": "shell",
            "command": "bash",
            "args": [
                "-c",
                "cd '${workspaceFolder}/api' && if [[ \"$(uname -s)\" == \"Linux\" ]]; then source .venv/bin/activate && api dev; else .venv/Scripts/activate.bat && api dev; fi"
            ],
            "options": {
                "cwd": "${workspaceFolder}/api"
            },
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "new",
                "showReuseMessage": true,
                "clear": false
            },
            "problemMatcher": []
        },
        {
            "label": "Celery Worker",
            "type": "shell",
            "command": "bash",
            "args": [
                "-c",
                "cd '${workspaceFolder}/api' && if [[ \"$(uname -s)\" == \"Linux\" ]]; then source .venv/bin/activate && api start_celery_worker; else .venv/Scripts/activate.bat && api start_celery_worker; fi"
            ],
            "options": {
                "cwd": "${workspaceFolder}/api"
            },
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "new",
                "showReuseMessage": true,
                "clear": false
            },
            "problemMatcher": []
        },
        {
            "label": "Celery Beat",
            "type": "shell",
            "command": "bash",
            "args": [
                "-c",
                "cd '${workspaceFolder}/api' && if [[ \"$(uname -s)\" == \"Linux\" ]]; then source .venv/bin/activate && api start_celery_beat; else .venv/Scripts/activate.bat && api start_celery_beat; fi"
            ],
            "options": {
                "cwd": "${workspaceFolder}/api"
            },
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "new",
                "showReuseMessage": true,
                "clear": false
            },
            "problemMatcher": []
        },
